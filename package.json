{
  "name": "vscode-mewlua",
  "displayName": "Mew Lua",
  "description": "%extension.description%",
  "version": "0.0.1",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:.emmyrc.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mewlua.startServer",
        "title": "%commands.startServer.title%",
        "icon": "$(play)"
      },
      {
        "command": "mewlua.stopServer",
        "title": "%commands.stopServer.title%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "mewlua.restartServer",
        "title": "%commands.restartServer.title%",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mewlua.openLogs",
        "title": "%commands.openLogs.title%",
        "icon": "$(output)"
      },
      {
        "command": "mewlua.showExtensionInfo",
        "title": "%commands.showExtensionInfo.title%",
        "icon": "$(info)"
      },
      {
        "command": "mewlua.showSyntaxTree",
        "title": "%commands.showSyntaxTree.title%",
        "icon": "$(symbol-structure)"
      }
    ],
    "languages": [
      {
        "id": "lua",
        "extensions": [
          ".lua"
        ],
        "aliases": [
          "MewLua"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lua",
        "scopeName": "source.lua",
        "path": "./syntaxes/lua.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "MewLua",
      "properties": {
        "mewlua.ls.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.ls.executablePath.markdownDescription%"
        },
        "mewlua.ls.startParameters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%configuration.ls.startParameters.markdownDescription%"
        },
        "mewlua.ls.globalConfigPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.ls.globalConfigPath.markdownDescription%"
        }
      }
    },
    "configurationDefaults": {
      "[lua]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": true,
          "strings": true
        },
        "editor.wordBasedSuggestions": "off"
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".emmyrc.json",
        "url": "%jsonValidation.emmyrc.url%"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run i18n:schema && pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "i18n:schema": "tsc -p scripts/i18n/tsconfig.json && node out/scripts/i18n/schema-i18n.js",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "js-yaml": "^5.2.1",
    "vscode-languageclient": "^10.1.0"
  }
}
